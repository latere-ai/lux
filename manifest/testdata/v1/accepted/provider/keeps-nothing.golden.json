{
  "apiVersion": "lux.latere.ai/v1beta1",
  "kind": "Provider",
  "metadata": {
    "name": "keeps-nothing"
  },
  "spec": {
    "dialect": "openai",
    "tunnel": false,
    "baseURL": "https://inference.example.com/v1",
    "credential": {
      "header": "Authorization",
      "scheme": "bearer"
    },
    "zeroRetention": {},
    "discovery": {
      "mode": "none"
    },
    "health": {
      "mode": "probe"
    },
    "timeout": "10m",
    "concurrency": 0
  },
  "status": {
    "warnings": []
  }
}
