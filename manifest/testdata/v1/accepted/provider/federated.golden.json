{
  "apiVersion": "lux.latere.ai/v1beta1",
  "kind": "Provider",
  "metadata": {
    "name": "anthropic-federated"
  },
  "spec": {
    "dialect": "anthropic",
    "tunnel": false,
    "baseURL": "https://anthropic.example.com/v1",
    "credential": {
      "header": "Authorization",
      "scheme": "bearer",
      "federation": {
        "ruleID": "fdrl_01ExampleRule",
        "organizationID": "4f6c1d2a-8e3b-4c7d-9a1e-2b5f6c7d8e9f",
        "serviceAccountID": "svac_01ExampleServiceAccount",
        "workspaceID": "wrkspc_01ExampleWorkspace"
      }
    },
    "discovery": {
      "mode": "auto"
    },
    "health": {
      "mode": "probe"
    },
    "timeout": "10m",
    "concurrency": 0
  },
  "status": {
    "warnings": []
  }
}
