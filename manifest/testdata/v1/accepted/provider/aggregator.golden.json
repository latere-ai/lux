{
  "apiVersion": "lux.latere.ai/v1beta1",
  "kind": "Provider",
  "metadata": {
    "name": "aggregator"
  },
  "spec": {
    "dialect": "openai",
    "tunnel": false,
    "baseURL": "https://aggregator.example.com/api/v1",
    "credential": {
      "header": "Authorization",
      "scheme": "bearer"
    },
    "requestFields": {
      "provider": {
        "data_collection": "deny",
        "order": [
          "vendor-a",
          "vendor-b"
        ],
        "zdr": true
      }
    },
    "discovery": {
      "mode": "none"
    },
    "health": {
      "mode": "probe"
    },
    "timeout": "10m",
    "concurrency": 0
  },
  "status": {
    "warnings": []
  }
}
