# The release image of spec 017: no build stage. The runtime stage is the
# developer image's between the two markers, byte for byte, and the one
# instruction of this file's own is the COPY of the binary the release
# pipeline built, checksummed, signed, and attested, so the image carries
# the same bytes the archive does. dist/luxd_linux_${TARGETARCH} is the
# file buildx substitutes per platform, so one
#
#	docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.release .
#
# produces one multi-arch index over the two binaries already measured.

# >>> shared runtime base <<<
# luxd forks no binary of its own, so the runtime stage is distroless,
# pinned by digest. It dials the providers, the OIDC issuers, and the
# authorizer and event webhooks over TLS, so the base carries the CA roots
# and nothing else, and runs as the image's non-root user with both
# listeners' ports exposed.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
EXPOSE 8080 8081
USER nonroot:nonroot
# <<< shared runtime base >>>
ARG TARGETARCH
COPY dist/luxd_linux_${TARGETARCH} /usr/local/bin/luxd
ENTRYPOINT ["/usr/local/bin/luxd"]
