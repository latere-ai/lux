#
# The core's configuration at Latere; every LUX_* variable is in the core's
# configuration reference. The four secrets (LUX_SECRETS_KEK,
# LUX_AUTHORIZER_TOKEN, LUX_EVENTS_SECRET, LUX_DB_URL and LUX_DB_POOL_URL)
# are the Secret luxd-secrets, applied by hand; the request log's rows are
# the optional Secret luxd-requestlog.
#
# The origin serves the core under /v1/models, and the core serves
# its whole listener under that base path (lux spec 034), so the Ingress
# forwards without a rewrite and the served document names the paths callers
# use. The base stands in the place of the core's own /v1 (lux spec 040), so
# every address carries one version segment: a Key is /v1/models/keys/{name},
# the doors stay /v1/models/openai/v1 and the others, and the probes answer
# on the internal port alone. platformd's clients address the control plane
# the same way, so this value and platformd's release change together.
LUX_PUBLIC_URL=https://api.latere.ai/v1/models
LUX_BASE_PATH=/v1/models
LUX_BASE_PATH_MODE=replace
LUX_OIDC_ISSUERS=https://auth.latere.ai
# The ingress controller's pods, which set X-Forwarded-For: the cluster's
# pod subnet, terraform's cluster_subnet.
LUX_TRUSTED_PROXIES=10.150.0.0/16
# platformd's internal TLS listener: the authorizer the core asks at Key
# apply, and the sink its signed events go to.
LUX_AUTHORIZER_URL=https://platformd-internal.latere.svc.cluster.local/internal/lux/authorize
LUX_EVENTS_URL=https://platformd-internal.latere.svc.cluster.local/internal/events/lux
# A list asks the authorizer about each object it returns, and platformd's
# authorizer admits a list only on that condition, so without it every list
# is refused, platformd's own key reconcile among them.
LUX_AUTHORIZE_LIST_ITEMS=1
# A Key or Budget the core has cached keeps serving up to this long past
# its cache window while the database does not answer; spend in
# that window is reconciled once the database is back, and a wallet it
# overdraws goes negative.
LUX_KEY_CACHE_GRACE=5m
# The core's database pool is one slot of the fleet's budget;
# each replica opens at most this many connections to the
# pooler, which multiplexes them onto its one server connection.
LUX_DB_MAX_CONNS=4
# Usage retention: a personal key's hourly usage rows
# become one row per month after 90 days, and the monthly rows are kept with
# every field; an organization's keys match no rule, so their hourly rows
# are kept with no end. The rule matches the kind label platformd sets on
# every Key it writes.
LUX_USAGE_RETENTION=[{"match":{"platform.latere.ai/kind":"personal"},"hourly":"2160h","monthly":"forever"}]
# The request log is written under one folder per key kind, `personal/`,
# `member/`, `service-account/`, and `_/` for a Key without the label, so
# the bucket's lifecycle rules (terraform) expire a personal key's records
# after 90 days and keep an organization's, as the usage rows are.
LUX_REQUESTLOG_PARTITION_LABEL=platform.latere.ai/kind
# An anthropic Provider may sign in with the core's own workload identity
# rather than a stored key (lux spec 051): for every exchange the core mints
# a token for its service account with Anthropic's audience, the default of
# LUX_WORKLOAD_IDENTITY_AUDIENCE. The Role is rbac.yaml's.
LUX_WORKLOAD_IDENTITY_KUBERNETES=1
