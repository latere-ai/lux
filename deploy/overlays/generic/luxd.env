#
# The gateway's configuration: every LUX_* variable is in the table of
# specs/002-repository-scaffold.md. The four secrets, LUX_SECRETS_KEK,
# LUX_AUTHORIZER_TOKEN, LUX_EVENTS_SECRET, and LUX_DB_URL, are never here;
# they are the Secret in deploy/bootstrap. With LUX_DB_URL in that Secret
# every replica shares one store and desired state survives a restart.
LUX_PUBLIC_URL=https://lux.example.com
LUX_OIDC_ISSUERS=https://issuer.example.com
# Each replica opens up to this many connections; the base runs two
# replicas and rolls without surging, so the store sees at most twice
# this plus one per replica. `luxd check` reports the arithmetic.
LUX_DB_MAX_CONNS=8
# Permission from your endpoint (specs/006-identity.md); its bearer is
# LUX_AUTHORIZER_TOKEN in the Secret. Leave both unset for the built-in
# owner policy with LUX_ADMIN_SUBJECTS instead.
LUX_AUTHORIZER_URL=https://authorizer.example.com/decide
# Every mutation, signed, to your sink (specs/012-request-log-and-events.md);
# its key is LUX_EVENTS_SECRET in the Secret. Leave unset for no events.
LUX_EVENTS_URL=https://events.example.com/lux
