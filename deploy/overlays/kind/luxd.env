#
# The gateway's configuration on a laptop cluster: every LUX_* variable
# is in the table of specs/002-repository-scaffold.md. The four secrets,
# LUX_SECRETS_KEK, LUX_AUTHORIZER_TOKEN, LUX_EVENTS_SECRET, and
# LUX_DB_URL, are never here; they are the Secret in deploy/bootstrap.
# Neither LUX_DB_URL nor LUX_MANIFEST_DIR is set, so every state lives in
# the one replica's memory and starts empty on a restart.
#
# The public URL is where the NodePort lands on the laptop, which the kind
# cluster configuration in docs/install.md maps to localhost:30080. The
# issuer is yours: the one whose tokens you hold. A plaintext issuer
# inside the cluster, as a lab's is, is listed in LUX_OIDC_INSECURE_ISSUERS
# too; a real installation never sets that variable.
LUX_PUBLIC_URL=http://localhost:30080
LUX_OIDC_ISSUERS=https://issuer.example.com
LUX_OIDC_INSECURE_ISSUERS=
# The subjects the built-in owner policy lets declare Providers and
# Models, rendered as <issuer>|<sub>; with LUX_AUTHORIZER_URL set the list
# is read and unused.
LUX_ADMIN_SUBJECTS=https://issuer.example.com|admin
# A laptop's model runtime sits on a private address.
LUX_UPSTREAM_ALLOW_PRIVATE=1
