/out/
# The release build of spec 017, tools/release/build.sh, writes the
# binaries and the archives here; the pipeline uploads them and a local
# run is never committed.
/dist/
*.cover.out
*.prof
*.test
.env
.env.*
!.env.example
.DS_Store
*.swp
.idea/
.vscode/
# rendered by the gate from latere.ai/x/ci-gate, never committed
.golangci.yml

# Generated by lateregate on every run; never committed.
coverage.out

# `go build ./cmd/<name>` or `go build ./examples/<name>` writes a binary
# named after the package into the working directory rather than out/.
# `make build` writes out/luxd; a binary at the repository root is always
# a stray from a bare `go build`, one rule per program in the tree.
/lux
/luxd
/lux-stubs
/authorizer
/plane

# An agent tool's worktrees, checked out under the repository and never
# part of it.
.claude/
