# luxd configuration. Copy to .env, edit, and load it into the process
# environment (docker run --env-file .env, a Compose env_file, or your
# supervisor). A blank value is unset; an unknown variable is ignored.
#
# Required variables are uncommented with a placeholder; edit each one. Optional
# variables are commented out with their default; uncomment to override.
#
# Generated from internal/config; the full reference is docs/configuration.md.
# It lists every LUX_* variable luxd reads and no others: the lux command's own
# are in docs/cli.md, the install script's LUX_INSTALL_* in docs/install.md, and
# the conformance suite's LUX_TEST_* in the conformance spec.

# --- Listeners ---

# Address the public listener binds: the dialect doors, the control plane under `/v1`, and the public probes.
# LUX_PUBLIC_ADDR=:8080

# Address the internal listener binds for the cluster's probes; must differ from `LUX_PUBLIC_ADDR` unless both ask for port 0.
# LUX_INTERNAL_ADDR=:8081

# Absolute URL callers reach the public listener at; the base of every URL in a response and the loop check of resolve.
LUX_PUBLIC_URL=https://lux.example.com

# --- Identity ---

# Comma-separated issuer URLs whose tokens the control plane accepts.
LUX_OIDC_ISSUERS=https://issuer.example.com

# The one audience a caller token must contain.
# LUX_OIDC_AUDIENCE=lux

# Issuers from the list allowed to use `http://` off loopback; the test stubs set it, never production.
# LUX_OIDC_INSECURE_ISSUERS=

# --- Authorizer ---

# The operator's authorization endpoint; unset selects the built-in owner policy.
# LUX_AUTHORIZER_URL=

# The bearer luxd sends the authorizer. Never echoed.
# required when LUX_AUTHORIZER_URL is set
# LUX_AUTHORIZER_TOKEN=

# One authorization decision's deadline, the retry included.
# LUX_AUTHORIZER_TIMEOUT=5s

# Comma-separated subjects the built-in owner policy lets act on every object; read and unused when an authorizer is set.
# LUX_ADMIN_SUBJECTS=

# --- Store ---

# A directory of manifests read at start: file mode, where desired state comes from disk and its kinds are read-only through the API.
# LUX_MANIFEST_DIR=

# A `postgres://` URL selecting the Postgres store; unset keeps every state in memory. Never echoed.
# LUX_DB_URL=

# Optional transaction-pooler URL for serving queries. Requires `LUX_DB_URL`, which remains the direct migration connection. Both must reach the same database. Never echoed.
# LUX_DB_POOL_URL=

# The Postgres pool size; read only with `LUX_DB_URL`, between 1 and 100.
# LUX_DB_MAX_CONNS=8

# --- Keys and limits ---

# How long a Key lookup, positive or negative, is cached per replica on the data plane (1s to 10m).
# LUX_KEY_CACHE=10s

# The requests-per-minute a Key gets when it names none; 0 is no limit.
# LUX_DEFAULT_REQUESTS_PER_MINUTE=0

# The tokens-per-minute a Key gets when it names none; 0 is no limit.
# LUX_DEFAULT_TOKENS_PER_MINUTE=0

# Control-plane requests one subject may send in a minute; 0 is no limit.
# LUX_REQUESTS_PER_MINUTE=600

# Requests one client address may send before authentication, on both planes; 0 is no limit.
# LUX_UNAUTHENTICATED_REQUESTS_PER_MINUTE=60

# Comma-separated CIDR ranges of front proxies whose `X-Forwarded-For` names the client; unset trusts no header.
# LUX_TRUSTED_PROXIES=

# The largest manifest or JSON body accepted on the control plane (1Ki to 16Mi).
# LUX_MAX_MANIFEST_BYTES=64Ki

# The largest data-plane request body, and the cap on an upstream body read whole (4Ki to 1Gi).
# LUX_MAX_BODY_BYTES=64Mi

# How often a replica writes its spend deltas and usage aggregates to the store (100ms to 1m).
# LUX_METERING_FLUSH=1s

# --- Providers and upstream ---

# 1 admits a Provider base URL, and the address it resolves to, on a loopback, link-local, or private network.
# LUX_UPSTREAM_ALLOW_PRIVATE=1

# The deadline of one upstream request including its stream (1s to 1h).
# LUX_UPSTREAM_TIMEOUT=10m

# How often a Provider's model list is refreshed (1m to 24h).
# LUX_DISCOVERY_INTERVAL=1h

# How often a Provider is health-probed (5s to 10m).
# LUX_HEALTH_INTERVAL=30s

# --- Events and request log ---

# The event sink; unset turns events off. Reached over `https://` or on loopback.
# LUX_EVENTS_URL=

# The HMAC-SHA256 key every delivery's `Lux-Signature` is signed with. Never echoed.
# required when LUX_EVENTS_URL is set
# LUX_EVENTS_SECRET=

# Where the request log is archived: `none` or `s3`.
# LUX_REQUESTLOG_EXPORTER=none

# The S3-compatible endpoint URL of the request-log archive; there is no default endpoint.
# required when LUX_REQUESTLOG_EXPORTER is s3
# LUX_S3_ENDPOINT=

# The request-log archive's region.
# LUX_S3_REGION=us-east-1

# The request-log archive's bucket.
# required when LUX_REQUESTLOG_EXPORTER is s3
# LUX_S3_BUCKET=

# The request-log archive's access key; there is no credential chain. Never echoed.
# required when LUX_REQUESTLOG_EXPORTER is s3
# LUX_S3_ACCESS_KEY=

# The request-log archive's secret key. Never echoed.
# required when LUX_REQUESTLOG_EXPORTER is s3
# LUX_S3_SECRET_KEY=

# The key prefix request-log objects are written under.
# LUX_S3_PREFIX=lux/

# --- Tunnel ---

# 1 serves the tunnel routes and admits `spec.tunnel`.
# LUX_TUNNEL_ENABLED=1

# The liveness window of a registry row; the agent heartbeats at a third of it (5s to 5m).
# LUX_TUNNEL_REGISTRY_TTL=30s

# The `host:port` other replicas reach this one's internal listener at; unset serves a tunnelled Provider on the holding replica only.
# LUX_TUNNEL_FORWARD_ADDR=

# Comma-separated bearers of the forward route: the first is sent, every one is accepted, so a rotation is prepending. Each at least 32 bytes. Never echoed.
# required when LUX_TUNNEL_FORWARD_ADDR is set
# LUX_TUNNEL_FORWARD_SECRET=

# --- Secrets ---

# One to eight 32-byte keys, standard base64, comma separated; the first wraps every new data key, every key is tried to open one, so rotation is prepending a key and running `luxd rewrap`. Never echoed.
# generate a key: head -c 32 /dev/urandom | base64
LUX_SECRETS_KEK=
